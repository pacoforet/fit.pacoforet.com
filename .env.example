# ==========================================
# Fit Dashboard - Environment Configuration
# ==========================================

# 1. Cloud Sync with GitHub Gist (Optional)
# If configured, your metrics will sync automatically across all devices.
# If omitted, the dashboard operates seamlessly in offline/local storage mode.
# Use a fine-grained token restricted to the "Gists: read & write" permission.
FIT_GITHUB_TOKEN=your_github_token_with_gist_permission
FIT_GIST_ID=your_github_gist_id

# 2. Login (Required for cloud sync)
# PBKDF2 hash of "username:password", verified server-side by /api/session.
# Generate yours running: npm run auth:hash
# If empty, login is disabled and the API rejects every request (demo mode still works).
# Never expose it with a PUBLIC_ prefix.
FIT_PASSWORD_HASH=

# 3. Display name shown in the dashboard header (Optional)
# PUBLIC_USER_NAME=Tu Nombre
