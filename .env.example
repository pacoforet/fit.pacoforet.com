# ==========================================
# Fit Dashboard - Environment Configuration
# ==========================================

# 1. Cloud Sync with GitHub Gist (Optional)
# If configured, your metrics will sync automatically across all devices.
# If omitted, the dashboard operates seamlessly in offline/local storage mode.
FIT_GITHUB_TOKEN=your_github_personal_access_token_with_gist_scope
FIT_GIST_ID=your_github_gist_id

# 2. Authentication Gate (Optional)
# SHA-256 hash of "username:password".
# Generate yours running: npm run auth:hash "myuser" "mypassword"
# If empty, the default demonstration credentials can be used.
FIT_AUTH_HASH=22610a297f0af193879f19dc56f88a7ab2434d7bcfe8f3ad75dc96d3e2f2a994
PUBLIC_AUTH_HASH=22610a297f0af193879f19dc56f88a7ab2434d7bcfe8f3ad75dc96d3e2f2a994

# Set to "false" if you wish to disable the password login screen completely (e.g., local home network):
# PUBLIC_ENABLE_AUTH=true
