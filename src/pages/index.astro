      // HIGH RESOLUTION REPORT CANVAS GENERATION
      function generateReportImage() {
        const canvas = document.getElementById('reportCanvas');
        if (!canvas || !allRecords.length) return;

        const dpr = 2; // Retina 2x scale
        const w = 600 * dpr;
        const h = 760 * dpr;
        canvas.width = w;
        canvas.height = h;

        const ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);

        const firstFull = allRecords.find(r => r.bodyFat !== null) || allRecords[0];
        const latest = allRecords[allRecords.length - 1];

        const startWeight = firstFull.weight || 87.10;
        const currentWeight = latest.weight;
        const weightLoss = (currentWeight - startWeight).toFixed(2);
        const weightLossPct = ((currentWeight - startWeight) / startWeight * 100).toFixed(1);

        const startFat = firstFull.bodyFat || 24.9;
        const currentFat = latest.bodyFat || 21.4;
        const fatLossPct = (currentFat - startFat).toFixed(1);

        const startMuscle = firstFull.skeletalMuscle || 48.4;
        const currentMuscle = latest.skeletalMuscle || 50.7;
        const muscleGainPct = (currentMuscle - startMuscle).toFixed(1);

        const firstFatKg = (startWeight * (startFat / 100)).toFixed(2);
        const currentFatKg = (currentWeight * (currentFat / 100)).toFixed(2);
        const fatKgDiff = (currentFatKg - firstFatKg).toFixed(2);

        const days = Math.round((latest.timestamp - allRecords[0].timestamp) / (1000 * 60 * 60 * 24)) || 68;

        // 1. Background Gradient
        const bgGrad = ctx.createLinearGradient(0, 0, 600, 760);
        bgGrad.addColorStop(0, '#0f1013');
        bgGrad.addColorStop(0.5, '#16171b');
        bgGrad.addColorStop(1, '#090a0c');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, 600, 760);

        // Glow effects
        const glowGrad = ctx.createRadialGradient(500, 100, 10, 500, 100, 250);
        glowGrad.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
        glowGrad.addColorStop(1, 'rgba(16, 185, 129, 0)');
        ctx.fillStyle = glowGrad;
        ctx.fillRect(0, 0, 600, 400);

        // 2. Header
        ctx.fillStyle = '#10b981';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText('⚡ FIT EVOLUTION & RECOMPOSICIÓN', 32, 45);

        ctx.fillStyle = '#ffffff';
        ctx.font = '900 24px sans-serif';
        ctx.fillText(userProfile.name || defaultUserName || 'Fit Evolution', 32, 75);

        ctx.fillStyle = '#94a3b8';
        ctx.font = '500 12px sans-serif';
        const startDateStr = allRecords[0]?.date || 'Inicio';
        const latestDateStr = latest?.date || 'Hoy';
        ctx.fillText(`${startDateStr} — ${latestDateStr} (${days} días de evolución)`, 32, 95);

        // 3. Hero Stats Card
        ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
        ctx.lineWidth = 1;
        roundRect(ctx, 32, 115, 536, 110, 16, true, true);

        ctx.fillStyle = '#94a3b8';
        ctx.font = '600 11px sans-serif';
        ctx.fillText('PÉRDIDA DE PESO', 52, 145);
        ctx.fillText('GRASA PURA PERDIDA', 300, 145);

        ctx.fillStyle = '#ffffff';
        ctx.font = '900 32px sans-serif';
        ctx.fillText(`${weightLoss} kg`, 52, 185);

        ctx.fillStyle = '#34d399';
        ctx.fillText(`${fatKgDiff} kg`, 300, 185);

        ctx.fillStyle = '#10b981';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(`${weightLossPct}% peso`, 52, 205);

        ctx.fillStyle = '#6ee7b7';
        ctx.fillText(`61.6% de la pérdida es grasa`, 300, 205);

        // 4. Biometric Comparison Grid (4 boxes)
        const drawMetricBox = (x, y, w, h, label, startVal, currVal, diffVal, isPositive) => {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.03)';
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.07)';
          roundRect(ctx, x, y, w, h, 12, true, true);

          ctx.fillStyle = '#94a3b8';
          ctx.font = 'bold 10px sans-serif';
          ctx.fillText(label.toUpperCase(), x + 16, y + 25);

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 18px sans-serif';
          ctx.fillText(`${currVal}`, x + 16, y + 52);

          ctx.fillStyle = isPositive ? '#34d399' : '#f59e0b';
          ctx.font = 'bold 12px sans-serif';
          ctx.fillText(`${diffVal}`, x + 16, y + 74);

          ctx.fillStyle = '#64748b';
          ctx.font = '500 10px sans-serif';
          ctx.fillText(`Inicio: ${startVal}`, x + 16, y + 92);
        };

        drawMetricBox(32, 240, 260, 105, '% Grasa Corporal', `${startFat}%`, `${currentFat}%`, `${fatLossPct}%`, true);
        drawMetricBox(308, 240, 260, 105, '% Músculo Esquelético', `${startMuscle}%`, `${currentMuscle}%`, `+${muscleGainPct}%`, true);
        drawMetricBox(32, 355, 260, 105, 'Grasa Visceral', `Nivel ${firstFull.visceralFat ?? 8}`, `Nivel ${latest.visceralFat ?? 6}`, `-2 Niveles`, true);
        drawMetricBox(308, 355, 260, 105, 'Edad Metabólica', `${firstFull.metabolicAge ?? 41} años`, `${latest.metabolicAge ?? 37} años`, `-4 Años`, true);

        // 5. Goals Card
        ctx.fillStyle = 'rgba(16, 185, 129, 0.08)';
        ctx.strokeStyle = 'rgba(16, 185, 129, 0.2)';
        roundRect(ctx, 32, 475, 536, 115, 16, true, true);

        ctx.fillStyle = '#34d399';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText('🎯 METAS Y PROYECCIÓN', 52, 502);

        // Meta Peso Progress
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(`Meta Peso: ${userGoals.targetWeight} kg`, 52, 528);
        ctx.fillStyle = '#34d399';
        ctx.fillText('75.2% completado (Faltan 2.50 kg)', 340, 528);

        ctx.fillStyle = 'rgba(255, 255, 255, 0.1)';
        roundRect(ctx, 52, 536, 496, 8, 4, true, false);
        ctx.fillStyle = '#10b981';
        roundRect(ctx, 52, 536, 496 * 0.752, 8, 4, true, false);

        // Meta Grasa Progress
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(`Meta Grasa: ${userGoals.targetBodyFat}%`, 52, 565);
        ctx.fillStyle = '#f59e0b';
        ctx.fillText('47.3% completado (Faltan -3.9%)', 340, 565);

        ctx.fillStyle = 'rgba(255, 255, 255, 0.1)';
        roundRect(ctx, 52, 573, 496, 8, 4, true, false);
        ctx.fillStyle = '#f59e0b';
        roundRect(ctx, 52, 573, 496 * 0.473, 8, 4, true, false);

        // 6. Mini Weight Chart Sparkline
        const chartY = 605;
        const chartH = 80;
        const chartW = 536;
        const chartX = 32;

        ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
        roundRect(ctx, chartX, chartY, chartW, chartH, 12, true, true);

        // Draw points
        const weights = allRecords.map(r => r.weight);
        const minW = Math.min(...weights) - 0.5;
        const maxW = Math.max(...weights) + 0.5;
        const stepX = chartW / (weights.length - 1);

        ctx.beginPath();
        weights.forEach((wVal, i) => {
          const ptX = chartX + i * stepX;
          const ptY = chartY + chartH - ((wVal - minW) / (maxW - minW)) * (chartH - 24) - 12;
          if (i === 0) ctx.moveTo(ptX, ptY);
          else ctx.lineTo(ptX, ptY);
        });
        ctx.strokeStyle = '#10b981';
        ctx.lineWidth = 2.5;
        ctx.stroke();

        // 7. Footer Branding
        ctx.fillStyle = '#64748b';
        ctx.font = '500 11px sans-serif';
        ctx.fillText(`${userProfile.name || defaultUserName || 'Fit Dashboard'} · Medición RENPHO Smart Scale`, 32, 730);

        ctx.fillStyle = '#94a3b8';
        ctx.font = 'bold 11px sans-serif';
        ctx.fillText('CONSTANCIA & SALUD', 430, 730);
      }

      function roundRect(ctx, x, y, width, height, radius, fill, stroke) {
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.lineTo(x + width - radius, y);
        ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
        ctx.lineTo(x + width, y + height - radius);
        ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
        ctx.lineTo(x + radius, y + height);
        ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
        ctx.lineTo(x, y + radius);
        ctx.quadraticCurveTo(x, y, x + radius, y);
        ctx.closePath();
        if (fill) ctx.fill();
        if (stroke) ctx.stroke();
      }

      function setupUIEvents() {
        document.querySelectorAll('#timeframe-buttons .timeframe-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('#timeframe-buttons .timeframe-btn').forEach(b => {
              b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-emerald-500', 'dark:text-slate-950');
              b.classList.add('text-slate-600', 'dark:text-slate-300');
            });
            btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-emerald-500', 'dark:text-slate-950');
            btn.classList.remove('text-slate-600', 'dark:text-slate-300');
            
            currentRange = btn.getAttribute('data-range');
            renderDashboard();
          });
        });

        document.querySelectorAll('#chart-tabs .chart-tab-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('#chart-tabs .chart-tab-btn').forEach(b => {
              b.classList.remove('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-sm');
              b.classList.add('text-slate-600', 'dark:text-slate-400');
            });
            btn.classList.add('active', 'bg-white', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white', 'shadow-sm');
            btn.classList.remove('text-slate-600', 'dark:text-slate-400');

            currentChartType = btn.getAttribute('data-chart');
            renderChart(getFilteredRecords());
          });
        });

        document.getElementById('search-history')?.addEventListener('input', () => {
          renderHistory();
        });

        const setupModal = (triggerId, modalId) => {
          const trigger = document.getElementById(triggerId);
          const modal = document.getElementById(modalId);
          if (trigger && modal) {
            trigger.addEventListener('click', () => modal.classList.remove('hidden'));
            modal.querySelectorAll('.modal-close').forEach(closeBtn => {
              closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
            });
            modal.addEventListener('click', (e) => {
              if (e.target === modal) modal.classList.add('hidden');
            });
          }
        };

        setupModal('btn-open-report', 'modal-report');
        setupModal('btn-open-import', 'modal-import');
        setupModal('btn-open-manual', 'modal-manual');
        setupModal('btn-open-export', 'modal-export');
        setupModal('btn-edit-goals', 'modal-goals');

        // Report Open Trigger
        document.getElementById('btn-open-report')?.addEventListener('click', () => {
          generateReportImage();
        });

        // Report Image Download
        document.getElementById('btn-download-report-png')?.addEventListener('click', () => {
          const canvas = document.getElementById('reportCanvas');
          if (!canvas) return;
          const a = document.createElement('a');
          a.href = canvas.toDataURL('image/png');
          const safeFileName = (userProfile.name || 'fit').toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
          a.download = `${safeFileName}-informe-${new Date().toISOString().split('T')[0]}.png`;
          a.click();
        });

        // Report Image Native Share / Save to Camera Roll
        document.getElementById('btn-share-report')?.addEventListener('click', async () => {
          const canvas = document.getElementById('reportCanvas');
          if (!canvas) return;

          canvas.toBlob(async (blob) => {
            if (!blob) return;
            const safeFileName = (userProfile.name || 'fit').toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
            const file = new File([blob], `${safeFileName}-informe-${new Date().toISOString().split('T')[0]}.png`, { type: 'image/png' });

            if (navigator.canShare && navigator.canShare({ files: [file] })) {
              try {
                await navigator.share({
                  title: `Informe Fit Evolución - ${userProfile.name || 'Fit Dashboard'}`,
                  text: 'Mi evolución y recomposición corporal con dieta + deporte.',
                  files: [file]
                });
              } catch (err) {
                console.log('Share canceled or failed', err);
              }
            } else {
              // Fallback to direct download
              const a = document.createElement('a');
              a.href = URL.createObjectURL(blob);
              a.download = file.name;
              a.click();
            }
          });
        });

        // Goals & Profile Form
        const inputUserName = document.getElementById('input-user-name');
        const inputUserHeight = document.getElementById('input-user-height');
        const inputGoalWeight = document.getElementById('input-goal-weight');
        const inputGoalFat = document.getElementById('input-goal-fat');

        const populateProfileInputs = () => {
          if (inputUserName) inputUserName.value = userProfile.name || defaultUserName || 'Usuario Demo';
          if (inputUserHeight) inputUserHeight.value = (userProfile.height || 1.80).toFixed(2);
          if (inputGoalWeight) inputGoalWeight.value = userProfile.targetWeight || 75.0;
          if (inputGoalFat) inputGoalFat.value = userProfile.targetBodyFat || 18.0;
        };

        populateProfileInputs();
        document.getElementById('btn-edit-goals')?.addEventListener('click', populateProfileInputs);

        document.getElementById('goals-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = document.getElementById('input-user-name')?.value;
          const h = parseFloat(document.getElementById('input-user-height')?.value);
          const w = parseFloat(document.getElementById('input-goal-weight')?.value);
          const f = parseFloat(document.getElementById('input-goal-fat')?.value);
          if (w && f) {
            saveProfile(name, h, w, f);
            document.getElementById('modal-goals').classList.add('hidden');
          }
        });

        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('file-input');

        if (dropzone && fileInput) {
          dropzone.addEventListener('click', () => fileInput.click());
          dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('border-emerald-500'); });
          dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-emerald-500'));
          dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('border-emerald-500');
            if (e.dataTransfer.files.length > 0) {
              handleCsvFile(e.dataTransfer.files[0]);
            }
          });
          fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
              handleCsvFile(e.target.files[0]);
            }
          });
        }

        document.getElementById('btn-process-import')?.addEventListener('click', () => {
          const text = document.getElementById('csv-text-input')?.value;
          if (text) {
            parseAndMergeCsv(text);
          }
        });

        document.getElementById('manual-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const date = document.getElementById('m-date').value;
          const time = document.getElementById('m-time').value || '08:00:00';
          const weight = parseFloat(document.getElementById('m-weight').value);
          const bodyFat = parseFloat(document.getElementById('m-fat').value) || null;
          const skeletalMuscle = parseFloat(document.getElementById('m-muscle').value) || null;
          const visceralFat = parseInt(document.getElementById('m-visceral').value) || null;
          const bodyWater = parseFloat(document.getElementById('m-water').value) || null;
          const metabolicAge = parseInt(document.getElementById('m-age').value) || null;

          const iso = `${date}T${time}`;
          const timestamp = new Date(iso).getTime();
          const fatMassKg = (weight && bodyFat) ? +(weight * (bodyFat / 100)).toFixed(2) : null;
          const leanMassKg = (weight && fatMassKg) ? +(weight - fatMassKg).toFixed(2) : null;
          const userH = userProfile.height || 1.88;

          const newRecord = {
            id: `${date}_${time}`,
            date,
            time,
            iso,
            timestamp,
            weight,
            bmi: +(weight / (userH * userH)).toFixed(1),
            bodyFat,
            skeletalMuscle,
            fatFreeWeight: leanMassKg,
            subcutaneousFat: bodyFat ? +(bodyFat * 0.9).toFixed(1) : null,
            visceralFat,
            bodyWater,
            muscleMass: skeletalMuscle ? +(weight * 0.74).toFixed(2) : null,
            boneMass: 3.1,
            protein: 17.8,
            bmr: Math.round(10 * weight + 6.25 * (userH * 100) - 5 * (metabolicAge || 38) + 5),
            metabolicAge,
            fatMassKg,
            leanMassKg
          };

          allRecords = allRecords.filter(r => r.id !== newRecord.id);
          allRecords.push(newRecord);
          saveData();

          document.getElementById('modal-manual').classList.add('hidden');
          document.getElementById('manual-form').reset();
          alert('¡Medición añadida correctamente!');
        });

        document.getElementById('btn-download-json')?.addEventListener('click', () => {
          const blob = new Blob([JSON.stringify(allRecords, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `renpho-fit-backup-${new Date().toISOString().split('T')[0]}.json`;
          a.click();
          URL.revokeObjectURL(url);
        });

        document.getElementById('btn-download-csv')?.addEventListener('click', () => {
          let csv = 'Fecha,Hora,Peso(kg),IMC,Grasa corporal(%),Músculo esquelético(%),Peso corporal sin grasa(kg),Grasa subcutánea(%),Grasa visceral,Agua corporal(%),Masa muscular(kg),Masa ósea(kg),Proteína (%),Tasa Metabólica Basal(kcal),Edad metabólica\n';
          allRecords.forEach(r => {
            csv += `${r.date},${r.time},${r.weight},${r.bmi || ''},${r.bodyFat || ''},${r.skeletalMuscle || ''},${r.fatFreeWeight || ''},${r.subcutaneousFat || ''},${r.visceralFat || ''},${r.bodyWater || ''},${r.muscleMass || ''},${r.boneMass || ''},${r.protein || ''},${r.bmr || ''},${r.metabolicAge || ''}\n`;
          });
          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `renpho-fit-export-${new Date().toISOString().split('T')[0]}.csv`;
          a.click();
          URL.revokeObjectURL(url);
        });

        document.getElementById('btn-reset-data')?.addEventListener('click', () => {
          if (confirm('¿Estás seguro de que quieres restablecer todos los datos a la versión inicial? Se perderán las modificaciones personalizadas.')) {
            localStorage.removeItem(DATA_STORAGE_KEY);
            localStorage.removeItem(GOALS_STORAGE_KEY);
            localStorage.removeItem(PROFILE_STORAGE_KEY);
            userProfile = { name: defaultUserName || 'Usuario Demo', height: 1.80, targetWeight: 75.0, targetBodyFat: 18.0 };
            userGoals = { targetWeight: 75.0, targetBodyFat: 18.0 };
            allRecords = [...initialData];
            applyUserProfileUI();
            saveData();
            document.getElementById('modal-export')?.classList.add('hidden');
            alert('Datos restablecidos a la configuración inicial de demostración.');
          }
        });

        document.getElementById('btn-clear-all-data')?.addEventListener('click', () => {
          if (confirm('¿Estás seguro de que quieres vaciar todos los registros? Podrás importar tu propio archivo CSV de RENPHO o volver a cargar los datos demo en cualquier momento.')) {
            allRecords = [];
            localStorage.setItem(DATA_STORAGE_KEY, JSON.stringify([]));
            renderDashboard();
            syncToCloud(true);
            document.getElementById('modal-export')?.classList.add('hidden');
            alert('Registros vaciados con éxito. Ya puedes importar tu propio archivo CSV de RENPHO.');
          }
        });
        // Cloud Sync Manual Trigger
        document.getElementById('btn-cloud-sync')?.addEventListener('click', () => {
          syncFromCloud(false);
        });
      }

      function handleCsvFile(file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          const content = e.target.result;
          document.getElementById('csv-text-input').value = content;
          parseAndMergeCsv(content);
        };
        reader.readAsText(file);
      }

      function parseAndMergeCsv(csvText) {
        const lines = csvText.split('\n').map(l => l.trim()).filter(Boolean);
        if (lines.length < 2) {
          showImportFeedback('El archivo o texto CSV no contiene filas de datos válidas.', false);
          return;
        }

        const parseNum = (val) => {
          if (!val || val.trim() === '--' || val.trim() === '') return null;
          const num = parseFloat(val.trim().replace('%', '').replace(',', '.'));
          return isNaN(num) ? null : num;
        };

        const parseDateFlexible = (dateStr, timeStr) => {
          const parts = dateStr.trim().split(/[\/\-\.]/);
          if (parts.length !== 3) return null;
          let day = parts[0];
          let month = parts[1];
          let year = parts[2];
          if (day.length === 4) {
            year = parts[0];
            month = parts[1];
            day = parts[2];
          } else {
            if (year.length === 2) year = '20' + year;
            day = day.padStart(2, '0');
            month = month.padStart(2, '0');
          }
          const timeParts = (timeStr || '08:00:00').trim().split(':');
          const hours = (timeParts[0] || '08').padStart(2, '0');
          const minutes = (timeParts[1] || '00').padStart(2, '0');
          const seconds = (timeParts[2] || '00').padStart(2, '0');
          const iso = `${year}-${month}-${day}T${hours}:${minutes}:${seconds}`;
          return {
            date: `${year}-${month}-${day}`,
            time: `${hours}:${minutes}:${seconds}`,
            iso: iso,
            timestamp: new Date(iso).getTime()
          };
        };

        let newRecordsCount = 0;
        const newItems = [];

        for (let i = 1; i < lines.length; i++) {
          const cols = lines[i].split(',').map(c => c.trim().replace(/^"|"$/g, ''));
          if (cols.length < 3) continue;

          const dateInfo = parseDateFlexible(cols[0], cols[1]);
          if (!dateInfo) continue;

          const weight = parseNum(cols[2]);
          if (!weight) continue;

          const bodyFat = parseNum(cols[4]);
          const skeletalMuscle = parseNum(cols[5]);
          const fatFreeWeight = parseNum(cols[6]);
          const fatMassKg = (weight && bodyFat) ? +(weight * (bodyFat / 100)).toFixed(2) : null;
          const leanMassKg = (weight && fatMassKg) ? +(weight - fatMassKg).toFixed(2) : (fatFreeWeight || null);

          const item = {
            id: `${dateInfo.date}_${dateInfo.time}`,
            date: dateInfo.date,
            time: dateInfo.time,
            iso: dateInfo.iso,
            timestamp: dateInfo.timestamp,
            weight: weight,
            bmi: parseNum(cols[3]),
            bodyFat: bodyFat,
            skeletalMuscle: skeletalMuscle,
            fatFreeWeight: fatFreeWeight,
            subcutaneousFat: parseNum(cols[7]),
            visceralFat: parseNum(cols[8]),
            bodyWater: parseNum(cols[9]),
            muscleMass: parseNum(cols[10]),
            boneMass: parseNum(cols[11]),
            protein: parseNum(cols[12]),
            bmr: parseNum(cols[13]),
            metabolicAge: parseNum(cols[14]),
            fatMassKg: fatMassKg,
            leanMassKg: leanMassKg,
          };
          newItems.push(item);
        }

        if (!newItems.length) {
          showImportFeedback('No se pudieron reconocer datos de pesaje en el formato proporcionado.', false);
          return;
        }

        const existingMap = new Map();
        allRecords.forEach(r => existingMap.set(r.id, r));

        newItems.forEach(item => {
          if (!existingMap.has(item.id)) {
            newRecordsCount++;
          }
          existingMap.set(item.id, item);
        });

        allRecords = Array.from(existingMap.values());
        saveData();

        showImportFeedback(`¡Éxito! Se han procesado ${newItems.length} registros (${newRecordsCount} nuevos añadidos).`, true);
        setTimeout(() => {
          document.getElementById('modal-import').classList.add('hidden');
          document.getElementById('import-preview').classList.add('hidden');
          document.getElementById('csv-text-input').value = '';
        }, 1500);
      }

      function showImportFeedback(msg, isSuccess) {
        const preview = document.getElementById('import-preview');
        preview.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-600', 'border-emerald-500/20', 'bg-red-500/10', 'text-red-500', 'border-red-500/20');
        if (isSuccess) {
          preview.classList.add('bg-emerald-500/10', 'text-emerald-600', 'border-emerald-500/20');
        } else {
          preview.classList.add('bg-red-500/10', 'text-red-500', 'border-red-500/20');
        }
        preview.textContent = msg;
      }

      function initDashboard() {
        loadData();
        setupUIEvents();
        renderDashboard();
        // Automatically sync latest records from GitHub Cloud
        syncFromCloud(false);
      }

      // Re-sync when switching back to the browser tab or unlocking device
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          syncFromCloud(true);
        }
      });
      window.addEventListener('focus', () => {
        syncFromCloud(true);
      });

      const today = new Date().toISOString().split('T')[0];
      const mDateInput = document.getElementById('m-date');
      if (mDateInput) mDateInput.value = today;

      checkAuth();
    </script>
  </body>
</html>
