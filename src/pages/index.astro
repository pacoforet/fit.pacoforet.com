    <!-- CLIENT JAVASCRIPT LOGIC -->
    <script define:vars={{ initialData, publicAuthHash, publicEnableAuth, defaultUserName }}>
      const AUTH_HASH = publicAuthHash || "22610a297f0af193879f19dc56f88a7ab2434d7bcfe8f3ad75dc96d3e2f2a994";
      const ENABLE_AUTH = publicEnableAuth !== false;
      const AUTH_STORAGE_KEY = "pacoforet_fit_auth_session";
      const DATA_STORAGE_KEY = "pacoforet_fit_data_records";
      const GOALS_STORAGE_KEY = "pacoforet_fit_user_goals";
      const PROFILE_STORAGE_KEY = "pacoforet_fit_user_profile";

      // Default Target Goals & User Profile
      let userProfile = {
        name: defaultUserName || "Usuario Demo",
        height: 1.80,
        targetWeight: 75.0,
        targetBodyFat: 18.0
      };

      let userGoals = {
        targetWeight: 75.0,
        targetBodyFat: 18.0
      };

      function applyUserProfileUI() {
        const isDemo = isDemoSession();
        const name = isDemo ? "Usuario Demo" : (userProfile.name || defaultUserName || "Usuario Demo");
        const headerName = document.getElementById('header-user-name');
        if (headerName) headerName.textContent = name;
        const footerName = document.getElementById('footer-user-name');
        if (footerName) footerName.textContent = name;
        document.title = isDemo ? "Fit Dashboard | Demo" : `Fit Dashboard | ${name}`;
        
        const ffmiLabel = document.getElementById('sec-ffmi-norm-label');
        if (ffmiLabel) {
          ffmiLabel.textContent = `Normalizado ${(userProfile.height || 1.80).toFixed(2)} m`;
        }
      }

      function loadProfile() {
        // 1. Backward compatibility: load goals first
        const storedGoals = localStorage.getItem(GOALS_STORAGE_KEY);
        if (storedGoals) {
          try {
            const parsed = JSON.parse(storedGoals);
            userProfile.targetWeight = parsed.targetWeight ?? userProfile.targetWeight;
            userProfile.targetBodyFat = parsed.targetBodyFat ?? userProfile.targetBodyFat;
          } catch(e) {}
        }
        // 2. Load profile
        const storedProfile = localStorage.getItem(PROFILE_STORAGE_KEY);
        if (storedProfile) {
          try {
            userProfile = Object.assign(userProfile, JSON.parse(storedProfile));
          } catch(e) {}
        }
        userGoals.targetWeight = userProfile.targetWeight;
        userGoals.targetBodyFat = userProfile.targetBodyFat;
        applyUserProfileUI();
      }

      function saveProfile(name, height, weight, fat) {
        userProfile.name = (name || '').trim() || defaultUserName || "Usuario Demo";
        userProfile.height = Math.max(1.0, Math.min(2.5, Number(height) || 1.80));
        userProfile.targetWeight = Number(weight) || 75.0;
        userProfile.targetBodyFat = Number(fat) || 18.0;
        userGoals.targetWeight = userProfile.targetWeight;
        userGoals.targetBodyFat = userProfile.targetBodyFat;

        localStorage.setItem(PROFILE_STORAGE_KEY, JSON.stringify(userProfile));
        localStorage.setItem(GOALS_STORAGE_KEY, JSON.stringify(userGoals));
        applyUserProfileUI();
        renderDashboard();
        syncToCloud(true);
      }

      // Backward compatible aliases
      function loadGoals() {
        loadProfile();
      }
      function saveGoals(weight, fat) {
        saveProfile(userProfile.name, userProfile.height, weight, fat);
      }

      async function sha256(message) {
        const msgBuffer = new TextEncoder().encode(message);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
      }

      const DEMO_SESSION_KEY = "demo_session";

      function isDemoSession() {
        return localStorage.getItem(AUTH_STORAGE_KEY) === DEMO_SESSION_KEY;
      }

      function checkAuth() {
        if (!ENABLE_AUTH) {
          document.getElementById('auth-gate').classList.add('hidden');
          document.getElementById('dashboard-app').classList.remove('hidden');
          requestAnimationFrame(() => {
            initDashboard();
          });
          return;
        }
        const session = localStorage.getItem(AUTH_STORAGE_KEY);
        if (session === AUTH_HASH || session === DEMO_SESSION_KEY) {
          document.getElementById('auth-gate').classList.add('hidden');
          document.getElementById('dashboard-app').classList.remove('hidden');
          requestAnimationFrame(() => {
            initDashboard();
          });
        } else {
          document.getElementById('auth-gate').classList.remove('hidden');
          document.getElementById('dashboard-app').classList.add('hidden');
        }
      }

      document.getElementById('btn-demo-access')?.addEventListener('click', () => {
        localStorage.setItem(AUTH_STORAGE_KEY, DEMO_SESSION_KEY);
        document.getElementById('login-error')?.classList.add('hidden');
        checkAuth();
      });

      document.getElementById('login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const user = document.getElementById('login-user').value.trim();
        const pass = document.getElementById('login-pass').value.trim();

        if (user.toLowerCase() === 'demo' && pass.toLowerCase() === 'demo') {
          localStorage.setItem(AUTH_STORAGE_KEY, DEMO_SESSION_KEY);
          document.getElementById('login-error')?.classList.add('hidden');
          checkAuth();
          return;
        }

        const hash = await sha256(`${user}:${pass}`);

        if (hash === AUTH_HASH) {
          localStorage.setItem(AUTH_STORAGE_KEY, hash);
          document.getElementById('login-error').classList.add('hidden');
          document.getElementById('auth-gate').classList.add('hidden');
          document.getElementById('dashboard-app').classList.remove('hidden');
          requestAnimationFrame(() => {
            initDashboard();
          });
        } else {
          document.getElementById('login-error').classList.remove('hidden');
        }
      });

      document.getElementById('btn-logout')?.addEventListener('click', () => {
        localStorage.removeItem(AUTH_STORAGE_KEY);
        checkAuth();
      });

      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.theme = isDark ? 'dark' : 'light';
        updateChartTheme();
      });

      let allRecords = [];
      let currentRange = 'all';
      let currentChartType = 'weight';
      let chartInstance = null;

      function setSyncBadge(state, text) {
        const dot = document.getElementById('cloud-sync-dot');
        const label = document.getElementById('cloud-sync-text');
        const btn = document.getElementById('btn-cloud-sync');
        if (!dot || !label || !btn) return;

        if (state === 'demo') {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-sky-500';
          label.textContent = text || 'Demo';
          btn.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20';
          btn.title = 'Modo Demostración activo con datos de prueba. Sincronización en la nube desactivada.';
        } else if (state === 'syncing') {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping';
          label.textContent = text || 'Sincronizando...';
          btn.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20';
        } else if (state === 'synced') {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500';
          label.textContent = text || 'Nube';
          btn.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
          btn.title = 'Sincronizado en la nube (GitHub). Pulsa para forzar actualización.';
        } else if (state === 'error') {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-red-500';
          label.textContent = text || 'Error';
          btn.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-red-500/10 text-red-500 border border-red-500/20';
        } else {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-slate-400';
          label.textContent = text || 'Local';
          btn.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700';
          btn.title = 'Modo local. Configura GITHUB_TOKEN en Vercel para activar sincronización automática.';
        }
      }

      async function syncFromCloud(silent = false) {
        if (isDemoSession()) {
          setSyncBadge('demo', 'Demo');
          return;
        }
        const session = localStorage.getItem(AUTH_STORAGE_KEY);
        if (!session) return;

        if (!silent) setSyncBadge('syncing', 'Sincronizando...');

        try {
          const res = await fetch('/api/fit-sync', {
            method: 'GET',
            headers: { 'x-fit-auth': session }
          });

          if (!res.ok) {
            if (!silent) setSyncBadge('error', 'Error sync');
            return;
          }

          const data = await res.json();
          if (!data.ok) {
            if (data.configured === false) {
              setSyncBadge('local', 'Local');
            } else {
              setSyncBadge('error', 'Error');
            }
            return;
          }

          // Process cloud records and profile
          const cloudRecords = data.records || [];
          if (data.profile) {
            userProfile = Object.assign(userProfile, data.profile);
            userGoals.targetWeight = userProfile.targetWeight;
            userGoals.targetBodyFat = userProfile.targetBodyFat;
            localStorage.setItem(PROFILE_STORAGE_KEY, JSON.stringify(userProfile));
            localStorage.setItem(GOALS_STORAGE_KEY, JSON.stringify(userGoals));
            applyUserProfileUI();
          } else if (data.goals) {
            userGoals = Object.assign(userGoals, data.goals);
            userProfile.targetWeight = userGoals.targetWeight;
            userProfile.targetBodyFat = userGoals.targetBodyFat;
            localStorage.setItem(GOALS_STORAGE_KEY, JSON.stringify(userGoals));
            localStorage.setItem(PROFILE_STORAGE_KEY, JSON.stringify(userProfile));
            applyUserProfileUI();
          }

          let hasNewFromCloud = false;
          let hasNewFromLocal = false;

          const mergedMap = new Map();
          // 1. Index local records
          allRecords.forEach(r => mergedMap.set(r.id, r));

          // 2. Merge cloud records
          cloudRecords.forEach(cr => {
            if (!mergedMap.has(cr.id)) {
              hasNewFromCloud = true;
              mergedMap.set(cr.id, cr);
            }
          });

          // Check if local has records missing in cloud
          if (cloudRecords.length > 0) {
            allRecords.forEach(lr => {
              if (!cloudRecords.some(cr => cr.id === lr.id)) {
                hasNewFromLocal = true;
              }
            });
          } else if (allRecords.length > 0) {
            hasNewFromLocal = true;
          }

          allRecords = Array.from(mergedMap.values());
          allRecords.sort((a, b) => a.timestamp - b.timestamp);
          localStorage.setItem(DATA_STORAGE_KEY, JSON.stringify(allRecords));

          if (hasNewFromCloud) {
            renderDashboard();
          }

          setSyncBadge('synced', 'Nube');

          // If local has new records not yet in cloud, upload them
          if (hasNewFromLocal) {
            syncToCloud(true);
          }
        } catch (err) {
          console.error('Sync error:', err);
          if (!silent) setSyncBadge('local', 'Local');
        }
      }

      async function syncToCloud(silent = false) {
        if (isDemoSession()) {
          setSyncBadge('demo', 'Demo');
          return;
        }
        const session = localStorage.getItem(AUTH_STORAGE_KEY);
        if (!session) return;

        if (!silent) setSyncBadge('syncing', 'Guardando...');

        try {
          const res = await fetch('/api/fit-sync', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-fit-auth': session
            },
            body: JSON.stringify({
              records: allRecords,
              goals: userGoals,
              profile: userProfile
            })
          });

          if (res.ok) {
            const data = await res.json();
            if (data.ok) {
              setSyncBadge('synced', 'Nube');
            } else if (data.configured === false) {
              setSyncBadge('local', 'Local');
            }
          }
        } catch (err) {
          console.error('Cloud save error:', err);
        }
      }

      function loadData() {
        loadGoals();
        if (isDemoSession()) {
          allRecords = [...initialData];
          allRecords.sort((a, b) => a.timestamp - b.timestamp);
          return;
        }
        const stored = localStorage.getItem(DATA_STORAGE_KEY);
        if (stored) {
          try {
            allRecords = JSON.parse(stored);
          } catch (e) {
            allRecords = initialData;
          }
        } else {
          allRecords = initialData;
        }
        allRecords.sort((a, b) => a.timestamp - b.timestamp);
      }

      function saveData() {
        allRecords.sort((a, b) => a.timestamp - b.timestamp);
        localStorage.setItem(DATA_STORAGE_KEY, JSON.stringify(allRecords));
        renderDashboard();
        syncToCloud(false);
      }

      function getFirstValid(prop) {
        return allRecords.find(r => r[prop] !== null && r[prop] !== undefined && !isNaN(r[prop]));
      }

      function getLatestValid(prop) {
        return [...allRecords].reverse().find(r => r[prop] !== null && r[prop] !== undefined && !isNaN(r[prop]));
      }

      function getFilteredRecords() {
        if (!allRecords.length) return [];
        if (currentRange === 'all') return allRecords;
        
        const latestTimestamp = allRecords[allRecords.length - 1].timestamp;
        let days = 30;
        if (currentRange === '14d') days = 14;
        if (currentRange === '7d') days = 7;
        
        const cutoff = latestTimestamp - (days * 24 * 60 * 60 * 1000);
        return allRecords.filter(r => r.timestamp >= cutoff);
      }

      function computeMovingAverage(records, windowSize = 7, prop = 'weight') {
        return records.map((record, idx, arr) => {
          const start = Math.max(0, idx - windowSize + 1);
          const windowItems = arr.slice(start, idx + 1);
          const validItems = windowItems.filter(item => item[prop] !== null && item[prop] !== undefined && !isNaN(item[prop]));
          if (!validItems.length) {
            const firstValid = arr.find(item => item[prop] !== null && item[prop] !== undefined && !isNaN(item[prop]));
            return firstValid ? firstValid[prop] : null;
          }
          const sum = validItems.reduce((acc, curr) => acc + curr[prop], 0);
          return +(sum / validItems.length).toFixed(2);
        });
      }

      function renderDashboard() {
        if (!allRecords.length) return;

        const latestRecord = allRecords[allRecords.length - 1];
        const filtered = getFilteredRecords();
        if (!filtered.length) return;

        const totalDays = Math.round((latestRecord.timestamp - allRecords[0].timestamp) / (1000 * 60 * 60 * 24)) || 1;
        const btnAll = document.getElementById('btn-range-all');
        if (btnAll) btnAll.textContent = `Todo (${totalDays}d)`;

        const badgeCount = document.getElementById('badge-records-count');
        if (badgeCount) badgeCount.textContent = `${allRecords.length}`;

        const formatDateReadable = (isoStr) => {
          const d = new Date(isoStr);
          return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        };
        document.getElementById('last-weighin-badge').textContent = formatDateReadable(latestRecord.iso);

        // Determine baseline record and period metadata
        let baselineRecord;
        let periodLabel;
        let daysInPeriod;

        if (currentRange === 'all') {
          baselineRecord = allRecords.find(r => r.bodyFat !== null && r.skeletalMuscle !== null) || allRecords[0];
          periodLabel = 'inicio';
          daysInPeriod = totalDays;
          
          document.getElementById('hero-period-badge').textContent = `Dieta + Deporte · 19 Jun 2026`;
          document.getElementById('hero-lost-label').textContent = 'Pérdida Total';
          document.getElementById('hero-fat-label').textContent = 'Grasa Pura';
          document.getElementById('hero-rate-label').textContent = 'Ritmo Medio';
          document.getElementById('hero-days-label').textContent = 'Días Activo';
        } else {
          baselineRecord = filtered[0];
          const rangeDays = currentRange === '7d' ? 7 : (currentRange === '14d' ? 14 : 30);
          periodLabel = `en ${rangeDays}d`;
          daysInPeriod = Math.max(1, Math.round((latestRecord.timestamp - baselineRecord.timestamp) / (1000 * 60 * 60 * 24)));
          
          document.getElementById('hero-period-badge').textContent = `Ventana: Últimos ${rangeDays} días (${filtered.length} pesajes)`;
          document.getElementById('hero-lost-label').textContent = `Pérdida (${rangeDays}d)`;
          document.getElementById('hero-fat-label').textContent = `Grasa (${rangeDays}d)`;
          document.getElementById('hero-rate-label').textContent = `Ritmo (${rangeDays}d)`;
          document.getElementById('hero-days-label').textContent = `Ventana`;
        }

        const periodWeeks = Math.max(1 / 7, daysInPeriod / 7);
        const weeksStr = (daysInPeriod / 7).toFixed(1);

        // 1. Weight Metrics & Weekly Rate
        const baseWeight = baselineRecord.weight;
        const latestWeight = latestRecord.weight;
        const weightDiff = latestWeight - baseWeight;
        const weightDiffPct = (weightDiff / baseWeight) * 100;
        const weeklyRate = Math.abs(weightDiff / periodWeeks).toFixed(2);

        // Fat Mass (kg)
        const baseFatKg = (baselineRecord.fatMassKg !== null && baselineRecord.fatMassKg !== undefined) 
          ? baselineRecord.fatMassKg 
          : (baseWeight * ((baselineRecord.bodyFat || 24.9) / 100));
        const latestFatKg = (latestRecord.fatMassKg !== null && latestRecord.fatMassKg !== undefined) 
          ? latestRecord.fatMassKg 
          : (latestWeight * ((latestRecord.bodyFat || 21.4) / 100));
        const fatKgDiff = latestFatKg - baseFatKg;

        // Render Hero Banner
        document.getElementById('hero-total-lost').textContent = `${weightDiff > 0 ? '+' : ''}${weightDiff.toFixed(2)} kg`;
        document.getElementById('hero-total-lost-pct').textContent = `${weightDiffPct.toFixed(1)}% peso`;
        document.getElementById('hero-fat-kg-lost').textContent = `${fatKgDiff > 0 ? '+' : ''}${fatKgDiff.toFixed(2)} kg`;
        document.getElementById('hero-weekly-rate').textContent = `${weeklyRate} kg/s`;
        document.getElementById('hero-days-active').textContent = `${daysInPeriod} d`;
        document.getElementById('hero-weeks-active').textContent = `~${weeksStr} sem`;

        // 1. KPI Peso
        document.getElementById('kpi-weight-val').textContent = latestWeight.toFixed(2);
        const kpiWeightDiff = document.getElementById('kpi-weight-diff');
        kpiWeightDiff.textContent = `${weightDiff > 0 ? '+' : ''}${weightDiff.toFixed(2)} kg`;
        kpiWeightDiff.className = `text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded ${weightDiff <= 0 ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-red-500/10 text-red-500'}`;
        document.getElementById('kpi-weight-period').textContent = periodLabel;

        // 2. KPI % Grasa
        const baseFat = baselineRecord.bodyFat ?? getFirstValid('bodyFat')?.bodyFat ?? 24.9;
        const latestFat = latestRecord.bodyFat ?? getLatestValid('bodyFat')?.bodyFat ?? 21.4;
        const fatDiff = latestFat - baseFat;
        document.getElementById('kpi-fat-val').textContent = latestFat.toFixed(1);
        const kpiFatDiff = document.getElementById('kpi-fat-diff');
        kpiFatDiff.textContent = `${fatDiff > 0 ? '+' : ''}${fatDiff.toFixed(1)}%`;
        kpiFatDiff.className = `text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded ${fatDiff <= 0 ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-amber-500/10 text-amber-500'}`;
        document.getElementById('kpi-fat-period').textContent = periodLabel;

        // 3. KPI % Músculo
        const baseMuscle = baselineRecord.skeletalMuscle ?? getFirstValid('skeletalMuscle')?.skeletalMuscle ?? 48.4;
        const latestMuscle = latestRecord.skeletalMuscle ?? getLatestValid('skeletalMuscle')?.skeletalMuscle ?? 50.7;
        const muscleDiff = latestMuscle - baseMuscle;
        document.getElementById('kpi-muscle-val').textContent = latestMuscle.toFixed(1);
        const kpiMuscleDiff = document.getElementById('kpi-muscle-diff');
        kpiMuscleDiff.textContent = `${muscleDiff > 0 ? '+' : ''}${muscleDiff.toFixed(1)}%`;
        kpiMuscleDiff.className = `text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded ${muscleDiff >= 0 ? 'bg-teal-500/10 text-teal-600 dark:text-teal-400' : 'bg-slate-500/10 text-slate-500'}`;
        document.getElementById('kpi-muscle-period').textContent = periodLabel;

        // 4. KPI Grasa Visceral
        const baseVisceral = baselineRecord.visceralFat ?? getFirstValid('visceralFat')?.visceralFat ?? 8;
        const latestVisceral = latestRecord.visceralFat ?? getLatestValid('visceralFat')?.visceralFat ?? 6;
        const viscDiff = latestVisceral - baseVisceral;
        document.getElementById('kpi-visceral-val').textContent = latestVisceral;
        const kpiViscDiff = document.getElementById('kpi-visceral-diff');
        kpiViscDiff.textContent = `${viscDiff > 0 ? '+' : ''}${viscDiff} niv`;
        kpiViscDiff.className = `text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded ${viscDiff <= 0 ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-red-500/10 text-red-500'}`;
        document.getElementById('kpi-visceral-period').textContent = periodLabel;

        // 5. KPI Edad Metabólica
        const baseAge = baselineRecord.metabolicAge ?? getFirstValid('metabolicAge')?.metabolicAge ?? 41;
        const latestAge = latestRecord.metabolicAge ?? getLatestValid('metabolicAge')?.metabolicAge ?? 37;
        const ageDiff = latestAge - baseAge;
        document.getElementById('kpi-age-val').textContent = latestAge;
        const kpiAgeDiff = document.getElementById('kpi-age-diff');
        kpiAgeDiff.textContent = `${ageDiff > 0 ? '+' : ''}${ageDiff} años`;
        kpiAgeDiff.className = `text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded ${ageDiff <= 0 ? 'bg-purple-500/10 text-purple-600 dark:text-purple-400' : 'bg-slate-500/10 text-slate-500'}`;
        document.getElementById('kpi-age-period').textContent = periodLabel;

        // 6. KPI % Agua
        const baseWater = baselineRecord.bodyWater ?? getFirstValid('bodyWater')?.bodyWater ?? 54.2;
        const latestWater = latestRecord.bodyWater ?? getLatestValid('bodyWater')?.bodyWater ?? 56.7;
        const waterDiff = latestWater - baseWater;
        document.getElementById('kpi-water-val').textContent = latestWater.toFixed(1);
        const kpiWaterDiff = document.getElementById('kpi-water-diff');
        kpiWaterDiff.textContent = `${waterDiff > 0 ? '+' : ''}${waterDiff.toFixed(1)}%`;
        kpiWaterDiff.className = `text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded ${waterDiff >= 0 ? 'bg-sky-500/10 text-sky-600 dark:text-sky-400' : 'bg-slate-500/10 text-slate-500'}`;
        document.getElementById('kpi-water-period').textContent = periodLabel;

        // Target Goals Calculation & UI
        const targetW = userGoals.targetWeight;
        const targetF = userGoals.targetBodyFat;
        document.getElementById('goal-weight-target-label').textContent = `${targetW.toFixed(1)} kg`;
        document.getElementById('goal-fat-target-label').textContent = `${targetF.toFixed(1)}%`;

        const globalFirstWeight = getFirstValid('weight')?.weight || 87.10;
        const totalWToLose = globalFirstWeight - targetW;
        const currentWLost = globalFirstWeight - latestWeight;
        const weightPct = Math.min(100, Math.max(0, (currentWLost / totalWToLose) * 100));
        const wRemaining = Math.max(0, latestWeight - targetW);

        document.getElementById('goal-weight-pct').textContent = `${weightPct.toFixed(1)}%`;
        document.getElementById('goal-weight-bar').style.width = `${weightPct.toFixed(1)}%`;
        document.getElementById('goal-weight-remaining').textContent = `${wRemaining.toFixed(2)} kg`;

        const rateForForecast = weeklyRate > 0.05 ? parseFloat(weeklyRate) : 0.65;
        const daysToGoal = Math.round((wRemaining / rateForForecast) * 7);
        const forecastDate = new Date(Date.now() + daysToGoal * 24 * 60 * 60 * 1000);
        const forecastStr = forecastDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
        const rateContextLabel = currentRange === 'all' ? 'ritmo medio' : `ritmo ${periodLabel}`;
        document.getElementById('goal-weight-forecast').innerHTML = `⏱️ Llegada estimada al ${rateContextLabel} (<strong>${rateForForecast} kg/s</strong>): <strong class="text-slate-700 dark:text-slate-300">~${daysToGoal} días</strong> (~${forecastStr})`;

        const globalFirstFat = getFirstValid('bodyFat')?.bodyFat || 24.9;
        const totalFatToDrop = globalFirstFat - targetF;
        const currentFatDropped = globalFirstFat - latestFat;
        const fatPct = Math.min(100, Math.max(0, (currentFatDropped / totalFatToDrop) * 100));
        const fatRemaining = Math.max(0, latestFat - targetF);

        document.getElementById('goal-fat-pct').textContent = `${fatPct.toFixed(1)}%`;
        document.getElementById('goal-fat-bar').style.width = `${fatPct.toFixed(1)}%`;
        document.getElementById('goal-fat-remaining').textContent = `-${fatRemaining.toFixed(1)}%`;

        // Secondary Metrics
        const latestMuscleMass = getLatestValid('muscleMass')?.muscleMass ?? 59.39;
        const baseMuscleMass = baselineRecord.muscleMass ?? getFirstValid('muscleMass')?.muscleMass ?? 62.10;
        document.getElementById('sec-muscle-mass').textContent = latestMuscleMass.toFixed(2);
        const mmDiff = latestMuscleMass - baseMuscleMass;
        document.getElementById('sec-muscle-diff').textContent = `${mmDiff > 0 ? '+' : ''}${mmDiff.toFixed(2)} kg`;

        const latestLeanMass = getLatestValid('leanMassKg')?.leanMassKg ?? (getLatestValid('fatFreeWeight')?.fatFreeWeight ?? 62.49);
        const baseLeanMass = baselineRecord.leanMassKg ?? (baselineRecord.fatFreeWeight ?? getFirstValid('fatFreeWeight')?.fatFreeWeight ?? 65.41);
        document.getElementById('sec-lean-mass').textContent = latestLeanMass.toFixed(2);
        const lmDiff = latestLeanMass - baseLeanMass;
        document.getElementById('sec-lean-diff').textContent = `${lmDiff > 0 ? '+' : ''}${lmDiff.toFixed(2)} kg`;

        const latestSubcut = getLatestValid('subcutaneousFat')?.subcutaneousFat ?? 19.4;
        const baseSubcut = baselineRecord.subcutaneousFat ?? getFirstValid('subcutaneousFat')?.subcutaneousFat ?? 22.3;
        document.getElementById('sec-subcut-fat').textContent = latestSubcut.toFixed(1);
        const subDiff = latestSubcut - baseSubcut;
        document.getElementById('sec-subcut-diff').textContent = `${subDiff > 0 ? '+' : ''}${subDiff.toFixed(1)}%`;

        const latestProtein = getLatestValid('protein')?.protein ?? 17.9;
        const baseProtein = baselineRecord.protein ?? getFirstValid('protein')?.protein ?? 17.1;
        document.getElementById('sec-protein').textContent = latestProtein.toFixed(1);
        const protDiff = latestProtein - baseProtein;
        document.getElementById('sec-protein-diff').textContent = `${protDiff > 0 ? '+' : ''}${protDiff.toFixed(1)}%`;

        const latestBone = getLatestValid('boneMass')?.boneMass ?? 3.10;
        document.getElementById('sec-bone').textContent = latestBone.toFixed(2);

        const latestBmr = getLatestValid('bmr')?.bmr ?? 1708;
        document.getElementById('sec-bmr').textContent = latestBmr;
        const latestBmi = getLatestValid('bmi')?.bmi ?? 22.5;
        document.getElementById('sec-bmi').textContent = latestBmi.toFixed(1);

        // 7. FFMI (Fat-Free Mass Index normalizado para la altura del usuario)
        const USER_HEIGHT_M = userProfile.height || 1.88;
        const ffmiLatest = latestLeanMass / (USER_HEIGHT_M * USER_HEIGHT_M);
        const ffmiNormalized = ffmiLatest + 6.1 * (1.8 - USER_HEIGHT_M);
        const ffmiValEl = document.getElementById('sec-ffmi-val');
        if (ffmiValEl) ffmiValEl.textContent = ffmiLatest.toFixed(1);
        const ffmiDiffEl = document.getElementById('sec-ffmi-diff');
        if (ffmiDiffEl) ffmiDiffEl.textContent = `norm: ${ffmiNormalized.toFixed(1)}`;
        const ffmiBadgeEl = document.getElementById('sec-ffmi-badge');
        if (ffmiBadgeEl) {
          if (ffmiNormalized >= 21) {
            ffmiBadgeEl.textContent = 'Excelente';
            ffmiBadgeEl.className = 'text-[9px] font-bold px-1.5 py-0.2 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400';
          } else if (ffmiNormalized >= 17) {
            ffmiBadgeEl.textContent = 'Atlético';
            ffmiBadgeEl.className = 'text-[9px] font-bold px-1.5 py-0.2 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
          } else {
            ffmiBadgeEl.textContent = 'Normal';
            ffmiBadgeEl.className = 'text-[9px] font-bold px-1.5 py-0.2 rounded bg-slate-500/10 text-slate-500';
          }
        }

        // 8. Milestones & Plateau Analysis
        const lowestRecord = allRecords.reduce((min, curr) => curr.weight < min.weight ? curr : min, allRecords[0]);
        const msLowestWeightEl = document.getElementById('ms-lowest-weight');
        const msLowestDateEl = document.getElementById('ms-lowest-date');
        if (msLowestWeightEl) msLowestWeightEl.textContent = `${lowestRecord.weight.toFixed(2)} kg`;
        if (msLowestDateEl) {
          const d = new Date(lowestRecord.iso);
          msLowestDateEl.textContent = d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' });
        }

        const minWeightAll = lowestRecord.weight;
        const barriersContainer = document.getElementById('ms-barriers-container');
        if (barriersContainer) {
          let html = '';
          if (minWeightAll < 85) html += '<span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] sm:text-[10px] font-bold">&lt;85kg ✓</span>';
          if (minWeightAll < 80) html += '<span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] sm:text-[10px] font-bold">&lt;80kg ✓</span>';
          if (minWeightAll < 78) html += '<span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[9px] sm:text-[10px] font-bold">&lt;78kg ✓</span>';
          else html += `<span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 text-[9px] sm:text-[10px] font-medium">Meta: 77kg</span>`;
          barriersContainer.innerHTML = html;
        }

        const moving7d = computeMovingAverage(allRecords, 7, 'weight');
        const latestMovingAvg = moving7d[moving7d.length - 1];
        const TWO_WEEKS_MS = 14 * 24 * 60 * 60 * 1000;
        const target14dTimestamp = latestRecord.timestamp - TWO_WEEKS_MS;
        let idx14d = 0;
        let minDiff = Infinity;
        for (let i = 0; i < allRecords.length; i++) {
          const diff = Math.abs(allRecords[i].timestamp - target14dTimestamp);
          if (diff < minDiff) {
            minDiff = diff;
            idx14d = i;
          }
        }
        const pastMovingAvg = moving7d[idx14d] || moving7d[0];
        const delta14d = latestMovingAvg - pastMovingAvg;
        const weekly14dRate = Math.abs((delta14d / 2)).toFixed(2);

        const plateauStatusBadge = document.getElementById('plateau-status-badge');
        const plateauInsightText = document.getElementById('plateau-insight-text');
        const plateauIcon = document.getElementById('plateau-icon');

        if (plateauStatusBadge && plateauInsightText) {
          if (Math.abs(delta14d) < 0.25) {
            plateauStatusBadge.textContent = 'Meseta';
            plateauStatusBadge.className = 'px-1.5 py-0.2 text-[9px] font-bold rounded bg-amber-500/10 text-amber-600 dark:text-amber-400';
            plateauInsightText.textContent = 'Variación < 0.2 kg · Ajustar o refeed';
            if (plateauIcon) plateauIcon.innerHTML = '<span class="text-sm sm:text-base">⏸️</span>';
          } else if (delta14d < 0) {
            plateauStatusBadge.textContent = 'Activo';
            plateauStatusBadge.className = 'px-1.5 py-0.2 text-[9px] font-bold rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
            plateauInsightText.textContent = `-${weekly14dRate} kg/sem · Déficit constante`;
            if (plateauIcon) plateauIcon.innerHTML = '<span class="text-sm sm:text-base">📉</span>';
          } else {
            plateauStatusBadge.textContent = 'Repunte';
            plateauStatusBadge.className = 'px-1.5 py-0.2 text-[9px] font-bold rounded bg-blue-500/10 text-blue-600 dark:text-blue-400';
            plateauInsightText.textContent = `+${delta14d.toFixed(2)} kg · Agua o sodio`;
            if (plateauIcon) plateauIcon.innerHTML = '<span class="text-sm sm:text-base">📈</span>';
          }
        }

        // 9. Transformación Día 1 vs Hoy (Foto Finish & P-Ratio)
        const firstFullScan = allRecords.find(r => r.bodyFat !== null && r.skeletalMuscle !== null) || allRecords[0];
        const h2hFirstWeight = firstFullScan.weight || 87.10;
        const h2hFirstFatPct = firstFullScan.bodyFat || 24.9;
        const h2hFirstFatKg = firstFullScan.fatMassKg || (h2hFirstWeight * (h2hFirstFatPct / 100));
        const h2hFirstMuscle = firstFullScan.skeletalMuscle || 48.4;
        const h2hFirstVisceral = firstFullScan.visceralFat || 8;
        const h2hFirstAge = firstFullScan.metabolicAge || 41;

        const h2hLatestWeight = latestRecord.weight;
        const h2hLatestFatPct = latestRecord.bodyFat || 21.0;
        const h2hLatestFatKg = latestRecord.fatMassKg || (h2hLatestWeight * (h2hLatestFatPct / 100));
        const h2hLatestMuscle = latestRecord.skeletalMuscle || 51.0;
        const h2hLatestVisceral = latestRecord.visceralFat || 6;
        const h2hLatestAge = latestRecord.metabolicAge || 37;

        const totalWDrop = h2hFirstWeight - h2hLatestWeight;
        const totalFatDropKg = h2hFirstFatKg - h2hLatestFatKg;
        const fatLossPctOfTotal = totalWDrop > 0 ? Math.min(100, Math.max(0, (totalFatDropKg / totalWDrop) * 100)) : 62;
        const leanLossPctOfTotal = Math.max(0, 100 - fatLossPctOfTotal);

        const goalFatLostSummary = document.getElementById('goal-fat-lost-summary');
        if (goalFatLostSummary) goalFatLostSummary.textContent = `-${totalFatDropKg.toFixed(2)} kg`;

        const recompFatPctEl = document.getElementById('recomp-fat-pct');
        if (recompFatPctEl) recompFatPctEl.textContent = `${fatLossPctOfTotal.toFixed(1)}%`;
        const recompMuscleValEl = document.getElementById('recomp-muscle-val');
        if (recompMuscleValEl) recompMuscleValEl.textContent = `${h2hLatestMuscle.toFixed(1)}%`;

        const pratioFatLabel = document.getElementById('pratio-fat-label');
        const pratioLeanLabel = document.getElementById('pratio-lean-label');
        const pratioFatBar = document.getElementById('pratio-fat-bar');
        const pratioLeanBar = document.getElementById('pratio-lean-bar');
        if (pratioFatLabel) pratioFatLabel.textContent = `${fatLossPctOfTotal.toFixed(1)}% (${totalFatDropKg.toFixed(1)}kg)`;
        if (pratioLeanLabel) pratioLeanLabel.textContent = `${leanLossPctOfTotal.toFixed(1)}%`;
        if (pratioFatBar) pratioFatBar.style.width = `${fatLossPctOfTotal.toFixed(1)}%`;
        if (pratioLeanBar) pratioLeanBar.style.width = `${leanLossPctOfTotal.toFixed(1)}%`;

        const h2hFatKgEl = document.getElementById('h2h-fat-kg');
        if (h2hFatKgEl) h2hFatKgEl.textContent = `${h2hFirstFatKg.toFixed(1)}kg → ${h2hLatestFatKg.toFixed(1)}kg (-${totalFatDropKg.toFixed(2)}kg)`;
        const h2hFatPctEl = document.getElementById('h2h-fat-pct');
        if (h2hFatPctEl) h2hFatPctEl.textContent = `${h2hFirstFatPct.toFixed(1)}% → ${h2hLatestFatPct.toFixed(1)}% (-${(h2hFirstFatPct - h2hLatestFatPct).toFixed(1)}%)`;
        const h2hVisceralEl = document.getElementById('h2h-visceral');
        if (h2hVisceralEl) h2hVisceralEl.textContent = `Niv ${h2hFirstVisceral} → ${h2hLatestVisceral} (${h2hLatestVisceral - h2hFirstVisceral})`;
        const h2hMetabolicAgeEl = document.getElementById('h2h-metabolic-age');
        if (h2hMetabolicAgeEl) h2hMetabolicAgeEl.textContent = `${h2hFirstAge} → ${h2hLatestAge} (${h2hLatestAge - h2hFirstAge} años)`;

        const butterPacks = Math.max(0, totalFatDropKg / 0.25).toFixed(1);
        const fatCalories = Math.round(Math.max(0, totalFatDropKg) * 7700);
        const equivButterEl = document.getElementById('equiv-butter');
        if (equivButterEl) equivButterEl.textContent = `~${butterPacks} paq. mantequilla`;
        const equivCaloriesEl = document.getElementById('equiv-calories');
        if (equivCaloriesEl) equivCaloriesEl.textContent = `~${fatCalories.toLocaleString('es-ES')} kcal déficit`;

        renderWeeklyTable();
        renderHistory();

        // Render Chart on next animation frame after layout pass
        requestAnimationFrame(() => {
          renderChart(filtered);
        });
      }

