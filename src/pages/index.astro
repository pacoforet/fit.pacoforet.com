---
import "../styles/global.css";
import AppHeader from "../components/AppHeader.astro";
import AuthGate from "../components/AuthGate.astro";
import BottomNav from "../components/BottomNav.astro";
import ConfirmDialog from "../components/dialogs/ConfirmDialog.astro";
import DataDialog from "../components/dialogs/DataDialog.astro";
import EntryDialog from "../components/dialogs/EntryDialog.astro";
import GoalsDialog from "../components/dialogs/GoalsDialog.astro";
import ImportDialog from "../components/dialogs/ImportDialog.astro";
import ReportDialog from "../components/dialogs/ReportDialog.astro";
import HistoryView from "../components/views/HistoryView.astro";
import SummaryView from "../components/views/SummaryView.astro";
import TrendsView from "../components/views/TrendsView.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Evolución de peso y composición corporal" />
    <title>Fit Dashboard</title>
    <link rel="icon" type="image/svg+xml" href="/fit-icon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/fit-icon.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Fit" />
    <meta name="theme-color" content="#f7f7f8" />

    <!-- Runs before paint: theme and session markers avoid a flash of the wrong screen -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var dark = false;
        try {
          dark = localStorage.theme === "dark" || (!("theme" in localStorage) && matchMedia("(prefers-color-scheme: dark)").matches);
          if (localStorage.getItem("pacoforet_fit_auth_session")) d.setAttribute("data-session", "");
        } catch (e) {}
        d.classList.toggle("dark", dark);
        document.querySelector('meta[name="theme-color"]').setAttribute("content", dark ? "#09090b" : "#f7f7f8");
      })();
    </script>
    <style is:global>
      html[data-session] #auth-gate,
      html:not([data-session]) #app {
        display: none;
      }
    </style>
  </head>
  <body class="min-h-dvh">
    <AuthGate />

    <div id="app">
      <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-surface focus:px-4 focus:py-2">Saltar al contenido</a>
      <AppHeader />
      <main id="main" class="mx-auto max-w-6xl px-4 pb-32 pt-5 sm:px-6 sm:pt-8 md:pb-16">
        <SummaryView />
        <TrendsView />
        <HistoryView />
      </main>
      <BottomNav />
    </div>

    <EntryDialog />
    <ImportDialog />
    <GoalsDialog />
    <DataDialog />
    <ReportDialog />
    <ConfirmDialog />

    <div
      id="toasts"
      class="pointer-events-none fixed inset-x-0 bottom-[calc(max(0.75rem,env(safe-area-inset-bottom))+5.5rem)] z-[60] flex flex-col items-center gap-2 px-4 md:bottom-6"
      role="status"
      aria-live="polite"
    >
    </div>

    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
