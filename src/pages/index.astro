---
import initialData from "../data/renpho-data.json";
import "../styles/global.css";

const publicAuthHash = import.meta.env.PUBLIC_AUTH_HASH || "22610a297f0af193879f19dc56f88a7ab2434d7bcfe8f3ad75dc96d3e2f2a994";
const publicEnableAuth = import.meta.env.PUBLIC_ENABLE_AUTH !== "false";
const defaultUserName = import.meta.env.PUBLIC_USER_NAME || "Usuario Demo";
---

<!doctype html>
<html lang="es" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Fit Dashboard | Recomposición Corporal</title>
    <link rel="icon" type="image/svg+xml" href="/fit-icon.svg" />
    
    <!-- PWA & iOS SPECIFIC META TAGS (iPhone 16 Pro Optimized) -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Fit Dashboard" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#0f1013" />
    <link rel="apple-touch-icon" href="/fit-icon.svg" />

    <script is:inline>
      document.documentElement.classList.toggle(
        "dark",
        localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches),
      );
    </script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
      /* Hide scrollbars for pill navigation while retaining swipe */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      /* Smooth touch scrolling */
      .touch-scroll {
        -webkit-overflow-scrolling: touch;
      }
      /* iPhone notch and dynamic island safe areas with generous margin */
      .safe-top {
        padding-top: max(0.85rem, calc(env(safe-area-inset-top, 0px) + 0.6rem));
      }
      .safe-bottom {
        padding-bottom: max(1.5rem, calc(env(safe-area-inset-bottom, 0px) + 1.25rem));
      }
    </style>
  </head>
  <body class="bg-slate-50 dark:bg-[#0f1013] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200 selection:bg-emerald-500/20 safe-bottom">
    
    <!-- AUTH GATE CONTAINER -->
    <div id="auth-gate" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 safe-top">
      <div class="w-full max-w-sm bg-white dark:bg-[#18191d] border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-20 -right-20 w-40 h-40 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -left-20 w-40 h-40 bg-teal-500/15 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="text-center mb-6">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-500 mb-3 border border-emerald-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h1 class="text-xl font-bold tracking-tight">Acceso Fit Dashboard</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Evolución & Composición Corporal</p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1" for="login-user">Usuario</label>
            <input 
              type="text" 
              id="login-user" 
              required 
              autocomplete="username"
              class="w-full px-4 py-3 text-base sm:text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
              placeholder="admin"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1" for="login-pass">Contraseña</label>
            <input 
              type="password" 
              id="login-pass" 
              required 
              autocomplete="current-password"
              class="w-full px-4 py-3 text-base sm:text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all"
              placeholder="••••••••••••"
            />
          </div>

          <div id="login-error" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-500 text-xs font-medium text-center">
            Usuario o contraseña incorrectos
          </div>

          <button 
            type="submit" 
            class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-semibold rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 text-sm cursor-pointer"
          >
            <span>Desbloquear</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </button>
        </form>

        <div class="relative my-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200 dark:border-slate-800"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-white dark:bg-[#18191d] px-2 text-slate-400 text-[10px] font-medium tracking-wider">o prueba sin cuenta</span>
          </div>
        </div>

        <button 
          type="button" 
          id="btn-demo-access" 
          class="w-full py-3 px-4 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-emerald-500/50 bg-slate-50 dark:bg-slate-900/60 hover:bg-emerald-500/5 text-slate-700 dark:text-slate-200 hover:text-emerald-600 dark:hover:text-emerald-400 text-xs font-semibold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm active:scale-[0.98]"
        >
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
          </svg>
          <span>Acceder en modo Demo (Datos de prueba)</span>
        </button>

        <div class="mt-5 text-center">
          <p class="text-[11px] text-slate-400">
            Fit Evolution Dashboard · Zero-Database Architecture
          </p>
        </div>
      </div>
    </div>

    <!-- MAIN DASHBOARD (HIDDEN UNTIL AUTH) -->
    <div id="dashboard-app" class="hidden flex-1 flex flex-col">
      
      <!-- TOP NAVIGATION BAR (CLEAN SOLID HEADER, NO OVERLAY / NO BLUR TINT) -->
      <header class="sticky top-0 z-40 bg-white dark:bg-[#0f1013] border-b border-slate-200 dark:border-slate-800/80 px-3 sm:px-6 lg:px-8 pb-3 safe-top">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
          
          <!-- Logo & Title -->
          <div class="flex items-center gap-2 sm:gap-3 min-w-0">
            <a href="/" class="flex items-center gap-2 group shrink-0">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
                </svg>
              </div>
              <span id="header-user-name" class="font-bold text-sm sm:text-base tracking-tight text-slate-900 dark:text-white truncate">{defaultUserName}</span>
            </a>
            <span class="text-slate-300 dark:text-slate-700">/</span>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="font-semibold text-emerald-600 dark:text-emerald-400 text-xs sm:text-sm truncate">Fit</span>
              <span id="badge-records-count" class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] sm:text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 whitespace-nowrap">
                71
              </span>
              <button 
                id="btn-cloud-sync" 
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:border-emerald-500/40 active:scale-95 transition-all cursor-pointer" 
                title="Sincronización en la nube (Pulsa para sincronizar)"
              >
                <span id="cloud-sync-dot" class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span id="cloud-sync-text" class="hidden xs:inline">Local</span>
              </button>
            </div>
          </div>

          <!-- Actions Header -->
          <div class="flex items-center gap-1 sm:gap-2 shrink-0">
            
            <!-- Botón Generar Imagen de Informe -->
            <button 
              id="btn-open-report" 
              class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white hover:bg-emerald-500 active:scale-95 shadow-sm shadow-emerald-600/20 transition-all"
              title="Exportar Informe Visual en Imagen"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z"/>
              </svg>
              <span class="hidden xs:inline">Informe</span>
            </button>

            <button 
              id="btn-open-import" 
              class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600/10 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-600/20 active:scale-95 border border-emerald-600/20 transition-all"
              title="Importar CSV de RENPHO"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
              </svg>
              <span class="hidden sm:inline">CSV</span>
            </button>

            <button 
              id="btn-open-manual" 
              class="inline-flex items-center gap-1 px-2.5 sm:px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-95 border border-slate-200 dark:border-slate-700 transition-all"
              title="Añadir pesaje manual"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
              </svg>
              <span class="hidden md:inline">+ Registro</span>
            </button>

            <button 
              id="btn-open-export" 
              class="p-1.5 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              title="Exportar / Backup"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
              </svg>
            </button>

            <button 
              id="theme-btn" 
              class="p-1.5 rounded-lg text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              title="Modo claro / oscuro"
            >
              <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
              <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/></svg>
            </button>

            <button 
              id="btn-logout" 
              class="p-1.5 rounded-lg text-slate-400 hover:text-red-500 dark:hover:text-red-400 transition-colors"
              title="Cerrar sesión"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75"/>
              </svg>
            </button>
          </div>
        </div>
      </header>

      <!-- DASHBOARD MAIN BODY -->
      <main class="max-w-7xl mx-auto w-full px-3 sm:px-6 lg:px-8 py-3 sm:py-6 space-y-3.5 sm:space-y-6">

        <!-- HERO SUMMARY BANNER -->
        <div class="relative overflow-hidden bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900 rounded-2xl sm:rounded-3xl p-4 sm:p-7 text-white shadow-lg">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-48 h-48 bg-emerald-400/20 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 sm:gap-6">
            <div>
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-white/10 backdrop-blur-md text-[10px] sm:text-xs font-semibold tracking-wide uppercase text-emerald-200 mb-2 border border-white/15">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                <span id="hero-period-badge">Dieta + Deporte · 19 Jun 2026</span>
              </div>
              <h2 class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight leading-tight">Evolución & Composición</h2>
            </div>

            <!-- 4 Quick Stats -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
              <div class="bg-black/30 backdrop-blur-md border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 text-center">
                <div id="hero-lost-label" class="text-[10px] sm:text-xs text-emerald-200/80 font-medium">Pérdida Total</div>
                <div id="hero-total-lost" class="text-lg sm:text-2xl font-black text-white mt-0.5">-7.60 kg</div>
                <div id="hero-total-lost-pct" class="text-[10px] text-emerald-300 font-semibold">-8.7% peso</div>
              </div>
              
              <div class="bg-black/30 backdrop-blur-md border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 text-center">
                <div id="hero-fat-label" class="text-[10px] sm:text-xs text-emerald-200/80 font-medium">Grasa Pura</div>
                <div id="hero-fat-kg-lost" class="text-lg sm:text-2xl font-black text-emerald-300 mt-0.5">-4.68 kg</div>
                <div class="text-[10px] text-emerald-200/90 font-semibold">61.6% grasa</div>
              </div>

              <div class="bg-black/30 backdrop-blur-md border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 text-center">
                <div id="hero-rate-label" class="text-[10px] sm:text-xs text-emerald-200/80 font-medium">Ritmo Medio</div>
                <div id="hero-weekly-rate" class="text-lg sm:text-2xl font-black text-white mt-0.5">0.78 kg/s</div>
                <div class="text-[10px] text-emerald-300 font-semibold">óptimo</div>
              </div>

              <div class="bg-black/30 backdrop-blur-md border border-white/10 rounded-xl sm:rounded-2xl p-2.5 sm:p-3 text-center">
                <div id="hero-days-label" class="text-[10px] sm:text-xs text-emerald-200/80 font-medium">Días Activo</div>
                <div id="hero-days-active" class="text-lg sm:text-2xl font-black text-white mt-0.5">68 d</div>
                <div id="hero-weeks-active" class="text-[10px] text-emerald-200/90 font-semibold">~9.7 sem</div>
              </div>
            </div>
          </div>
        </div>

        <!-- TIMEFRAME SELECTOR -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 bg-white dark:bg-[#16171b] p-2 sm:p-2.5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="flex items-center gap-1 overflow-x-auto no-scrollbar touch-scroll w-full sm:w-auto" id="timeframe-buttons">
            <button id="btn-range-all" data-range="all" class="timeframe-btn active shrink-0 px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-900 text-white dark:bg-emerald-500 dark:text-slate-950 transition-all">
              Todo
            </button>
            <button data-range="30d" class="timeframe-btn shrink-0 px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
              30 días
            </button>
            <button data-range="14d" class="timeframe-btn shrink-0 px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
              14 días
            </button>
            <button data-range="7d" class="timeframe-btn shrink-0 px-3 py-1.5 text-xs font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
              7 días
            </button>
          </div>

          <div class="flex items-center justify-between sm:justify-end gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 px-1">
            <span>Última medición:</span>
            <span id="last-weighin-badge" class="font-bold text-slate-800 dark:text-slate-200 bg-slate-100 dark:bg-slate-800/80 px-2 py-0.5 rounded-lg border border-slate-200 dark:border-slate-700">
              --
            </span>
          </div>
        </div>

        <!-- 6 PRIMARY KPI CARDS -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3.5">
          
          <!-- KPI 1: PESO -->
          <div class="bg-white dark:bg-[#16171b] border border-slate-200/90 dark:border-slate-800/90 rounded-2xl p-3 sm:p-4 shadow-sm flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
            <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
              <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider">Peso Actual</span>
              <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0l-4-4m4 4l4-4"/></svg>
              </div>
            </div>
            <div>
              <div class="flex items-baseline gap-1">
                <span id="kpi-weight-val" class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight">--</span>
                <span class="text-[11px] sm:text-xs font-bold text-slate-400">kg</span>
              </div>
              <div class="flex items-center gap-1 mt-0.5">
                <span id="kpi-weight-diff" class="text-[10px] sm:text-xs font-black px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">--</span>
                <span id="kpi-weight-period" class="text-[9px] sm:text-[10px] text-slate-400">inicio</span>
              </div>
            </div>
          </div>

          <!-- KPI 2: % GRASA -->
