      function renderWeeklyTable() {
        const tbody = document.getElementById('weekly-table-body');
        if (!tbody || !allRecords.length) return;

        const startTime = allRecords[0].timestamp;
        const ONE_WEEK_MS = 7 * 24 * 60 * 60 * 1000;
        const weeks = [];

        let currentWeekNum = 1;
        let weekStart = startTime;

        while (weekStart <= allRecords[allRecords.length - 1].timestamp) {
          const weekEnd = weekStart + ONE_WEEK_MS;
          const weekRecords = allRecords.filter(r => r.timestamp >= weekStart && r.timestamp < weekEnd);
          
          if (weekRecords.length > 0) {
            const firstOfW = weekRecords[0];
            const lastOfW = weekRecords[weekRecords.length - 1];
            const diff = lastOfW.weight - firstOfW.weight;
            
            const fats = weekRecords.map(r => r.bodyFat).filter(Boolean);
            const avgFat = fats.length ? (fats.reduce((a, b) => a + b, 0) / fats.length).toFixed(1) : '--';

            const muscles = weekRecords.map(r => r.skeletalMuscle).filter(Boolean);
            const avgMuscle = muscles.length ? (muscles.reduce((a, b) => a + b, 0) / muscles.length).toFixed(1) : '--';
            
            const formatDateShort = (dStr) => {
              const [y, m, d] = dStr.split('-');
              return `${parseInt(d)}/${parseInt(m)}`;
            };

            weeks.push({
              weekNum: currentWeekNum,
              period: `${formatDateShort(firstOfW.date)} - ${formatDateShort(lastOfW.date)}`,
              startWeight: firstOfW.weight,
              endWeight: lastOfW.weight,
              diff: diff,
              avgFat: avgFat,
              avgMuscle: avgMuscle,
            });
          }
          currentWeekNum++;
          weekStart = weekEnd;
        }

        const badgeTotalWeeks = document.getElementById('badge-total-weeks');
        if (badgeTotalWeeks) badgeTotalWeeks.textContent = `${weeks.length} semanas`;

        let bestWeek = null;
        for (const w of weeks) {
          if (w.diff < 0 && (!bestWeek || w.diff < bestWeek.diff)) {
            bestWeek = w;
          }
        }
        const msBestWeekVal = document.getElementById('ms-best-week-val');
        const msBestWeekName = document.getElementById('ms-best-week-name');
        if (msBestWeekVal && bestWeek) msBestWeekVal.textContent = `${bestWeek.diff.toFixed(2)} kg`;
        if (msBestWeekName && bestWeek) msBestWeekName.textContent = `Semana ${bestWeek.weekNum}`;

        weeks.reverse();

        tbody.innerHTML = weeks.map(w => `
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors">
            <td class="py-2 px-3 font-bold text-slate-900 dark:text-white text-xs">
              Sem ${w.weekNum} <span class="text-[10px] text-slate-400 font-normal">(${w.period})</span>
            </td>
            <td class="py-2 px-3 text-right font-bold text-slate-900 dark:text-white text-xs">${w.endWeight.toFixed(2)}kg</td>
            <td class="py-2 px-3 text-right">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-black ${w.diff <= 0 ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-red-500/10 text-red-600 dark:text-red-400'}">
                ${w.diff > 0 ? '+' : ''}${w.diff.toFixed(2)}
              </span>
            </td>
            <td class="py-2 px-3 text-right text-amber-600 dark:text-amber-400 font-bold text-xs">${w.avgFat}%</td>
            <td class="py-2 px-3 text-right text-teal-600 dark:text-teal-400 font-bold text-xs hidden sm:table-cell">${w.avgMuscle}%</td>
          </tr>
        `).join('');
      }

      function renderHistory() {
        const tbody = document.getElementById('history-table-body');
        const mobileList = document.getElementById('history-mobile-list');
        if (!allRecords.length) return;

        const searchQuery = (document.getElementById('search-history')?.value || '').toLowerCase().trim();
        let recordsToDisplay = [...allRecords].reverse();

        if (searchQuery) {
          recordsToDisplay = recordsToDisplay.filter(r => r.date.includes(searchQuery) || r.time.includes(searchQuery));
        }

        // 1. Render Mobile Feed Cards
        if (mobileList) {
          mobileList.innerHTML = recordsToDisplay.map((r, i) => {
            const nextChronological = recordsToDisplay[i + 1];
            let diffHtml = '';
            if (nextChronological) {
              const diff = r.weight - nextChronological.weight;
              const colorClass = diff <= 0 
                ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10' 
                : 'text-red-600 dark:text-red-400 bg-red-500/10';
              diffHtml = `<span class="px-1.5 py-0.5 rounded text-[10px] font-black ${colorClass}">${diff > 0 ? '+' : ''}${diff.toFixed(2)} kg</span>`;
            }

            return `
