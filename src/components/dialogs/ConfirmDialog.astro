<dialog id="dlg-confirm" class="sheet sm:max-w-md!" aria-labelledby="confirm-title" aria-describedby="confirm-body">
  <form method="dialog" class="p-6">
    <h2 id="confirm-title" class="text-lg font-semibold tracking-tight"></h2>
    <p id="confirm-body" class="mt-2 text-fg-2"></p>
    <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <button type="submit" value="cancel" class="btn btn-ghost">Cancelar</button>
      <button id="confirm-ok" type="submit" value="ok" class="btn btn-primary"></button>
    </div>
  </form>
</dialog>
