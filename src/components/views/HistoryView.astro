---
import Icon from "../Icon.astro";
---

<section id="view-historial" data-view="historial" class="space-y-4 sm:space-y-6" aria-labelledby="historial-title" hidden>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 id="historial-title" class="text-2xl font-semibold tracking-tight">Historial</h1>
      <p id="history-count" class="mt-1 text-fg-2"></p>
    </div>
    <div class="flex items-center gap-2">
      <div class="relative flex-1 sm:w-64 sm:flex-none">
        <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-fg-3"><Icon name="search" /></span>
        <label for="history-search" class="sr-only">Buscar por fecha</label>
        <input id="history-search" type="search" class="input pl-10" placeholder="Buscar por fecha, p. ej. 24 ago" autocomplete="off" />
      </div>
      <div class="relative hidden sm:block">
        <button type="button" class="btn btn-secondary" data-menu="columns-menu" aria-haspopup="menu" aria-expanded="false">
          <Icon name="sliders" />Columnas
        </button>
        <div id="columns-menu" class="menu max-h-[60dvh] overflow-y-auto" role="menu" aria-label="Columnas visibles" hidden></div>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="hidden max-h-[70dvh] overflow-auto sm:block">
      <table class="w-full text-sm">
        <thead id="history-head" class="sticky top-0 z-10 bg-surface shadow-[inset_0_-1px_0_var(--border)]"></thead>
        <tbody id="history-body" class="divide-y divide-border"></tbody>
      </table>
    </div>
    <div id="history-list" class="sm:hidden"></div>
    <p id="history-empty" class="p-10 text-center text-fg-2" hidden>Ningún pesaje coincide con la búsqueda.</p>
    <div id="history-more-wrap" class="flex justify-center border-t border-border p-3" hidden>
      <button id="history-more" type="button" class="btn btn-ghost">Mostrar más</button>
    </div>
  </div>
</section>
